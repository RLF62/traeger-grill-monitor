[Unit]
Description=Traeger Grill Monitor dashboard
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/traeger-grill-monitor
ExecStart=/home/pi/.local/bin/gunicorn --bind 0.0.0.0:8081 --workers 1 --threads 4 --timeout 30 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

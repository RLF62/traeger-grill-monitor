[Unit]
Description=Traeger Grill Monitor dashboard
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/traeger-grill-monitor
ExecStart=/usr/bin/python3 /home/pi/traeger-grill-monitor/run_preview.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

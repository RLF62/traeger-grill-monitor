[Unit]
Description=Traeger RGB Wi-Fi status LED
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service
Before=network.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/traeger-grill-monitor
ExecStart=/usr/bin/python3 /home/pi/traeger-grill-monitor/led_status.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
